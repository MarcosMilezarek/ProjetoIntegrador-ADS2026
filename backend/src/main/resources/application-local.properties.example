# Copie este arquivo para application-local.properties e preencha com os dados do MySQL.
# O arquivo application-local.properties NAO e versionado (ver backend/.gitignore).
#
# ATENCAO: o que estiver aqui SOBRESCREVE o application.properties. Se o host apontar para
# um servidor inalcancavel, a aplicacao nao sobe (o Flyway falha no startup).
#
# O MySQL do projeto e o da VPS e so aceita conexao de localhost na VM. Para rodar o backend
# na sua maquina, abra um tunel SSH antes e mantenha a url apontando para localhost:
#   gcloud compute ssh --zone "southamerica-east1-c" cloudvmads #     --project "project-9558c67f-ba71-45f5-82b" -- -L 3306:localhost:3306

spring.datasource.url=jdbc:mysql://localhost:3306/selecao_rh?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
spring.datasource.username=seu_usuario
spring.datasource.password=sua_senha

# Segredo do JWT para rodar localmente (minimo 32 caracteres; gere com: openssl rand -base64 48).
# Na VPS nao defina aqui: use JWT_SECRET no backend.service (o que estiver neste arquivo sobrescreve a variavel).
# app.jwt.secret=

# Triagem por IA (OpenRouter): chave e modelo. Preencha so aqui (arquivo nao versionado) ou por variavel
# de ambiente OPENROUTER_API_KEY e OPENROUTER_MODEL. Deixe comentado se for usar as variaveis.
# app.openrouter.api-key=
# app.openrouter.model=
