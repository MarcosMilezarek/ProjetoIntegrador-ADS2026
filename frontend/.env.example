# URL base da API. Se nao informar, o frontend usa http://localhost:8080/api.
# A tela de login (entrar e criar cadastro) SEMPRE fala com o backend por esta URL.
VITE_API_URL=http://localhost:8080/api

# Com "false": tudo usa a API real, com o token JWT do login.
# Com "true": tudo fica em dados locais de demonstracao (o login ainda usa a API).
VITE_USE_MOCK_API=true
