# URL base da API. Se nao informar, o frontend usa http://localhost:8080/api.
# A tela de login (entrar e criar cadastro) SEMPRE fala com o backend por esta URL.
VITE_API_URL=http://localhost:8080/api

# Com "false": vagas e curriculo passam a usar a API real (GET/POST/PUT /vagas e /curriculos).
# Candidaturas, documentos e notificacoes continuam em dados locais de demonstracao, pois
# ainda nao tem endpoints no backend.
VITE_USE_MOCK_API=true
