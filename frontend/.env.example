# URL base da API. Se nao informar, o frontend usa http://localhost:8080/api.
# A tela de login (entrar e criar cadastro) SEMPRE fala com o backend por esta URL.
VITE_API_URL=http://localhost:8080/api

# Afeta apenas o portal depois do login (vagas, curriculo, documentos), que ainda
# nao tem endpoints no backend e por isso continua em dados locais de demonstracao.
VITE_USE_MOCK_API=true
