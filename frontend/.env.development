# Valores do `npm run dev`. Não entram no build de produção (`npm run build`).
# O banco é sempre o da VPS: o Vite repassa /api para https://upteam.duckdns.org (ver vite.config.ts).
# Para usar um backend local, crie .env.development.local (ignorado pelo git) com:
#   VITE_API_URL=http://localhost:8081/api
VITE_API_URL=/api

# Tudo usa a API real, com o token do login.
VITE_USE_MOCK_API=false
